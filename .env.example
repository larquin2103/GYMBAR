# Configuración de Firebase para la app (Vite expone solo las VITE_*).
# Copiar a app/.env.local y rellenar con los valores del proyecto Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Poner en "true" para apuntar la app a los emuladores locales.
VITE_USE_FIREBASE_EMULATORS=false
