rules_version = '2';

// Modelo de una cuenta por gimnasio (ver docs/13, patrón contamypime).
// Cada gimnasio es una cuenta de Firebase cuyo uid ES el organizationId; todos
// sus datos cuelgan de /organizations/{orgId}. Solo quien inició sesión con esa
// cuenta (auth.uid == orgId) puede leer/escribir. Los roles del personal son
// datos internos de la app (login por PIN), no permisos de Firebase.
service cloud.firestore {
  match /databases/{database}/documents {

    function isGym(orgId) {
      return request.auth != null && request.auth.uid == orgId;
    }

    match /organizations/{orgId} {
      allow read, write: if isGym(orgId);

      // Todo el árbol de datos del gimnasio (miembros, pagos, ventas, caja,
      // rutinas, personal, etc.). Aislamiento por tenant vía uid == orgId.
      match /{document=**} {
        allow read, write: if isGym(orgId);
      }
    }
  }
}
